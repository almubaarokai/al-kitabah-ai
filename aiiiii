            inputField.value = promptText;
            inputField.focus();
        }}

        function copyText(button) {{
            const text = button.parentNode.firstChild.textContent.trim();
            navigator.clipboard.writeText(text).then(() => {{
                const orig = button.innerText; button.innerText = "✅ Tersalin!";
                setTimeout(() => {{ button.innerText = orig; }}, 1500);
            }});
        }}

        function clearChatArea() {{
            if(confirm("Apakah Anda ingin memuat ulang dan membersihkan layar chat ini?")) {{ window.location.reload(); }}
        }}

        function showErrorToast(msg) {{
            const toast = document.getElementById('error-toast');
            toast.innerText = msg; toast.classList.remove('hidden');
            setTimeout(() => {{ toast.classList.add('hidden'); }}, 4000);
        }}

        async function sendMessage() {{
            const inputField = document.getElementById('chat-input');
            const sendBtn = document.getElementById('send-btn');
            const loading = document.getElementById('loading-indicator');
            const msg = inputField.value.trim();
            if (!msg) return;

            const userBubble = `<div class="flex justify-end"><div class="max-w-[85%] bg-emerald-600 text-white rounded-2xl rounded-tr-none px-4 py-3 shadow-md"><p class="text-sm leading-relaxed whitespace-pre-wrap arabic-text text-right">\${escapeHTML(msg)}</p></div></div>`;
            loading.insertAdjacentHTML('beforebegin', userBubble);
            inputField.value = '';
            
            loading.classList.remove('hidden');
            sendBtn.disabled = true; sendBtn.classList.add('opacity-50');
            scrollToBottom();

            try {{
                const r = await fetch('/api/chat', {{
                    method: 'POST',
                    headers: {{ 'Content-Type': 'application/json' }},
                    body: JSON.stringify({{ message: msg }})
                }});
                const d = await r.json();
                if (d.success) {{
                    const aiBubble = `<div class="flex justify-start"><div class="max-w-[85%] bg-white border border-slate-100 text-slate-800 rounded-2xl rounded-tl-none px-4 py-3 shadow-sm"><p class="text-sm leading-relaxed whitespace-pre-wrap">\${escapeHTML(d.reply)}</p><button onclick="copyText(this)" class="mt-2 text-[10px] uppercase font-bold tracking-wider text-slate-400 hover:text-emerald-600 transition-all">📋 Salin Jawaban</button></div></div>`;
                    loading.insertAdjacentHTML('beforebegin', aiBubble);
                }} else {{
                    showErrorToast(d.error || "Terjadi kesalahan.");
                }}
            }} catch {{
                showErrorToast("Koneksi bermasalah. Pastikan server tetap berjalan.");
            }} finally {{
                loading.classList.add('hidden');
                sendBtn.disabled = false; sendBtn.classList.remove('opacity-50');
                scrollToBottom();
            }}
        }}

        function escapeHTML(str) {{
            return str.replace(/[&<>'"]/g, t => ({{ '&': '&amp;', '<': '&lt;', '>': '&gt;', "'": '&#39;', '"': '&quot;' }}[t] || t));
        }}

        document.getElementById('chat-input').addEventListener('keydown', function(e) {{
            if (e.key === 'Enter' && !e.shiftKey) {{ e.preventDefault(); sendMessage(); }}
        }});
