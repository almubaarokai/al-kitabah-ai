import os
import logging
from flask import Flask, request, jsonify, session, redirect, url_for, render_template_string
import google.generativeai as genai

# ==========================================
# 1. CONFIGURATION & LOGGING SETUP
# ==========================================
logging.basicConfig(level=logging.INFO)
logger = logging.getLogger(__name__)

app = Flask(__name__)
# Menggunakan secret key acak untuk keamanan enkripsi session data
app.secret_key = os.urandom(24).hex()

SYSTEM_PROMPT = (
    "Kamu adalah guru Bahasa Arab profesional khusus Maharah Kitabah untuk siswa kelas 10 "
    "Madrasah Aliyah. Tugasmu membantu siswa belajar menulis Bahasa Arab dengan baik dan benar. "
    "Setiap kesalahan harus diperbaiki dengan penjelasan sederhana dalam Bahasa Indonesia. "
    "Berikan contoh kalimat yang benar dan latihan lanjutan secara bertahap. "
    "Gunakan gaya mengajar yang ramah, memotivasi, dan mudah dipahami."
)

# ==========================================
# 2. AI INTERACTION SERVICE
# ==========================================
class AIService:
    @staticmethod
    def generate_response(api_key: str, chat_history: list, user_message: str) -> dict:
        try:
            # Konfigurasi API secara dinamis per request (Keamanan Terjaga)
            genai.configure(api_key=api_key)
            
            model = genai.GenerativeModel(
                model_name='gemini-1.5-flash',
                system_instruction=SYSTEM_PROMPT
            )
            
            # Konversi format history dari Flask session ke format Gemini
            formatted_history = []
            for msg in chat_history:
                role = "user" if msg["role"] == "user" else "model"
                formatted_history.append({"role": role, "parts": [msg["content"]]})
            
            chat = model.start_chat(history=formatted_history)
            response = chat.send_message(user_message)
            
            return {"success": True, "reply": response.text}
            
        except genai.types.generation_types.BlockedPromptException:
            return {"success": False, "error": "Pesan Anda mengandung konten yang tidak diizinkan oleh sistem keamanan."}
        except Exception as e:
            logger.error(f"Error pada AI Service: {str(e)}")
            return {"success": False, "error": "Gagal terhubung ke AI. Pastikan API Key Anda valid dan internet stabil."}

# ==========================================
# 3. ROUTING & CONTROLLERS
# ==========================================
@app.route('/')
def index():
    if 'username' in session and 'api_key' in session:
        return redirect(url_for('dashboard'))
    return redirect(url_for('login'))

@app.route('/login', methods=['GET', 'POST'])
def login():
    error = None
    if request.method == 'POST':
        username = request.form.get('username', '').strip()
        api_key = request.form.get('api_key', '').strip()
        
        if not username or not api_key:
            error = "Username dan API Key tidak boleh kosong!"
        else:
            session['username'] = username
            session['api_key'] = api_key
            session['chat_history'] = [
                {
                    "role": "assistant", 
                    "content": f"Ahlan wa sahlan, {username}! 👋 Selamat datang di kelas Maharah Kitabah. Saya siap membimbingmu menulis bahasa Arab dengan benar. Silakan klik menu latihan di samping atau langsung ketik kalimat Arabmu di bawah!"
                }
            ]
            return redirect(url_for('dashboard'))
        
    return render_template_string(LOGIN_TEMPLATE, error=error)

@app.route('/dashboard')
def dashboard():
    if 'username' not in session or 'api_key' not in session:
        return redirect(url_for('login'))
    return render_template_string(DASHBOARD_TEMPLATE, username=session['username'], chat_history=session['chat_history'])

@app.route('/api/chat', methods=['POST'])
def chat():
    if 'api_key' not in session:
        return jsonify({"success": False, "error": "Sesi Anda telah berakhir. Silakan login kembali."}), 401
        
    data = request.get_json() or {}
    user_message = data.get('message', '').strip()
    
    if not user_message:
        return jsonify({"success": False, "error": "Pesan tidak boleh kosong."}), 400
        
    history = session.get('chat_history', [])
    
    ai_response = AIService.generate_response(session['api_key'], history, user_message)
    
    if ai_response['success']:
        history.append({"role": "user", "content": user_message})
        history.append({"role": "assistant", "content": ai_response['reply']})
        session['chat_history'] = history
        session.modified = True
        return jsonify({"success": True, "reply": ai_response['reply']})
    else:
        return jsonify({"success": False, "error": ai_response['error']}), 500

@app.route('/logout')
def logout():
    session.clear()
    return redirect(url_for('login'))

